# Uploaded media storage. Keep this false for local filesystem development.
SUPABASE_STORAGE_ENABLED=false
SUPABASE_S3_BUCKET=miranda-insights-media
SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<supabase-project-region>
SUPABASE_S3_ACCESS_KEY_ID=<server-only-supabase-s3-access-key>
SUPABASE_S3_SECRET_ACCESS_KEY=<server-only-supabase-s3-secret-key>
SUPABASE_S3_QUERYSTRING_EXPIRE=604800
SURVEYHQ_DURABLE_STORAGE_READY=false
